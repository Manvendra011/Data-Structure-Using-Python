#Insert an element x at ith position in the singly linked list  
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class SinglyLinkedList:
    def __init__(self):
        self.head = None
    def insert_at_beginning(self, x):
        new_node = Node(x)
        new_node.next = self.head
        self.head = new_node
    def insert_at_position(self, x, i):
        new_node = Node(x)
        if i == 0:
            new_node.next = self.head
            self.head = new_node
            return
        
        current = self.head
        count = 0
        while current is not None and count < i - 1:
            current = current.next
            count += 1

        if current is None:
            print("Position out of bounds!")
            return
        new_node.next = current.next
        current.next = new_node

    def display(self):
        current = self.head
        while current:
            print(current.data, end=" -> ")
            current = current.next
        print("None")
if __name__ == "__main__":
    sll = SinglyLinkedList()
    
    # Inserting at beginning
    sll.insert_at_beginning(10)
    sll.insert_at_beginning(20)
    sll.insert_at_beginning(30)
    sll.insert_at_position(25, 1)  # Insert 25 at position 1
    sll.insert_at_position(5, 4)   # Insert 5 at position 4
    sll.insert_at_position(100, 10)  # Invalid position
    sll.display()






#Remove an element from the beginning of the doubly linked list 
class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

class DoublyLinkedList:
    def __init__(self):
        self.head = None
    def insert_at_beginning(self, x):
        new_node = Node(x)
        if self.head is not None:
            new_node.next = self.head
            self.head.prev = new_node
        self.head = new_node

    def remove_from_beginning(self):
        if self.head is None:
            print("List is empty! Nothing to remove.")
            return

        if self.head.next is None:
            self.head = None
        else:
            self.head = self.head.next
            self.head.prev = None
    def display(self):
        current = self.head
        while current:
            print(current.data, end=" <-> ")
            current = current.next
        print("None")
if __name__ == "__main__":
    dll = DoublyLinkedList()
    
    dll.insert_at_beginning(10)
    dll.insert_at_beginning(20)
    dll.insert_at_beginning(30)

    print("Original List:")
    dll.display()
    dll.remove_from_beginning()
    print("\nAfter removing one element from beginning:")
    dll.display()
    dll.remove_from_beginning()
    print("\nAfter removing another element from beginning:")
    dll.display()
    dll.remove_from_beginning()
    print("\nAfter removing last element from beginning:")
    dll.display()
    dll.remove_from_beginning()  






